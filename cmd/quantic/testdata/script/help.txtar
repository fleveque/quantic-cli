# Asking for help isn't an error: exit 0, usage on stdout.

exits 0 quantic
stdout '^Usage:$'
stdout 'version +Print the version of quantic'
! stderr .

exits 0 quantic --help
stdout '--json +print JSON for programs'
stdout '--timeout duration +give up on Quantic after this long \(default 10s\)'

exits 0 quantic help version
stdout 'quantic version \[flags\]'

# Cobra's, for the packages to install (milestone 7).
exec quantic --help
stdout 'completion +Generate the autocompletion script for the specified shell'

exec quantic completion bash
stdout '^# bash completion V2 for quantic'
exec quantic completion zsh
stdout '^#compdef quantic'
exec quantic completion fish
stdout 'complete -c quantic'
