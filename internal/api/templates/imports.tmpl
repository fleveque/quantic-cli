{{- /*
  oapi-codegen's imports.tmpl (v2.8.0) with one change: a blank line between
  the "Code generated" comment and the package clause. Without it the comment
  is a second package doc, and `go doc ./internal/api` prints it before
  doc.go's. Unused imports are removed after generation, so this list only has
  to cover what the generator may use.
*/ -}}
{{- if opts.Generate.StdHTTPServer}}//go:build go1.22

{{- end}}

// Code generated by {{.ModuleName}} version {{.Version}} DO NOT EDIT.

package {{.PackageName}}

import (
	"bytes"
	"compress/flate"
	"context"
	"encoding/base64"
	"encoding/json"
	"encoding/xml"
	"errors"
	"fmt"
	"go.yaml.in/yaml/v3"
	"io"
	"os"
	"mime"
	"mime/multipart"
	"net/http"
	"net/url"
	"path"
	"strings"
	"time"

	"github.com/oapi-codegen/runtime"
	"github.com/oapi-codegen/nullable"
	openapi_types "github.com/oapi-codegen/runtime/types"
	"github.com/getkin/kin-openapi/openapi3"
	{{- range .RouterImports}}
	{{if .Alias}}{{.Alias}} {{end}}"{{.Package}}"
	{{- end}}
	{{- range .ExternalImports}}
	{{ . }}
	{{- end}}
	{{- range .AdditionalImports}}
	{{.Alias}} "{{.Package}}"
	{{- end}}
)
